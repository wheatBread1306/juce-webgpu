include_guard(GLOBAL)
include(FetchContent)

function(_wgpu_native_download name url)
    FetchContent_Declare(${name} URL "${url}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(${name})
    FetchContent_GetProperties(${name} SOURCE_DIR dir)
    set(_wgpu_dir "${dir}" PARENT_SCOPE)
endfunction()

function(wgpu_native_fetch tag)
    if(TARGET wgpu_native)
        return()
    endif()

    set(base "https://github.com/gfx-rs/wgpu-native/releases/download/${tag}")

    if(WIN32)
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
            set(arch aarch64)
        else()
            set(arch x86_64)
        endif()
        _wgpu_native_download(wgpu_native_bin "${base}/wgpu-windows-${arch}-msvc-release.zip")
        set(include_dir "${_wgpu_dir}/include")
        set(library "${_wgpu_dir}/lib/wgpu_native.lib")
        set(system_libs d3dcompiler ws2_32 userenv bcrypt ntdll opengl32 propsys runtimeobject
                        user32 gdi32 ole32 oleaut32 advapi32 dxgi)

    elseif(APPLE)
        set(archs ${CMAKE_OSX_ARCHITECTURES})
        if(NOT archs)
            set(archs ${CMAKE_HOST_SYSTEM_PROCESSOR})
        endif()

        set(libs "")
        foreach(a IN LISTS archs)
            if(a STREQUAL "arm64" OR a STREQUAL "aarch64")
                set(rust_arch aarch64)
            else()
                set(rust_arch x86_64)
            endif()
            _wgpu_native_download(wgpu_native_bin_${rust_arch} "${base}/wgpu-macos-${rust_arch}-release.zip")
            list(APPEND libs "${_wgpu_dir}/lib/libwgpu_native.a")
            set(include_dir "${_wgpu_dir}/include")
        endforeach()

        list(REMOVE_DUPLICATES libs)
        list(LENGTH libs lib_count)
        if(lib_count GREATER 1)
            set(library "${CMAKE_BINARY_DIR}/wgpu_native/${tag}/libwgpu_native.a")
            if(NOT EXISTS "${library}")
                file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/wgpu_native/${tag}")
                execute_process(COMMAND lipo -create ${libs} -output "${library}"
                                RESULT_VARIABLE lipo_result)
                if(NOT lipo_result EQUAL 0)
                    message(FATAL_ERROR "wgpu_native_fetch: lipo failed (${lipo_result})")
                endif()
            endif()
        else()
            list(GET libs 0 library)
        endif()
        set(system_libs "-framework Metal" "-framework QuartzCore" "-framework Foundation" "-framework CoreGraphics")

    else()
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
            set(arch aarch64)
        else()
            set(arch x86_64)
        endif()
        _wgpu_native_download(wgpu_native_bin "${base}/wgpu-linux-${arch}-release.zip")
        set(include_dir "${_wgpu_dir}/include")
        set(library "${_wgpu_dir}/lib/libwgpu_native.a")
        set(system_libs dl pthread m)
    endif()

    if(NOT EXISTS "${library}")
        message(FATAL_ERROR "wgpu_native_fetch: library not found: ${library}")
    endif()

    add_library(wgpu_native STATIC IMPORTED GLOBAL)
    set_target_properties(wgpu_native PROPERTIES
            IMPORTED_LOCATION "${library}"
            INTERFACE_INCLUDE_DIRECTORIES "${include_dir}"
            INTERFACE_LINK_LIBRARIES "${system_libs}")
    message(STATUS "wgpu-native ${tag}: ${library}")
endfunction()
